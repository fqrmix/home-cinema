POSTGRES_DB=homecinema
POSTGRES_USER=homecinema
POSTGRES_PASSWORD=change-me

# bcrypt hash of the single app password. Generate with:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
APP_PASSWORD_HASH=
# 32+ random bytes, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_TOKEN_TTL=720h

TMDB_API_KEY=
# Created once in Jellyfin's admin dashboard (Dashboard -> API Keys).
JELLYFIN_API_KEY=

TRANSMISSION_URL=http://192.168.1.1:9091/transmission/rpc
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=

RUTRACKER_LOGIN=
RUTRACKER_PASSWORD=

# Only needed for the smb-nfs-bridge service (profile "remote-lan-bridge")
# — if this host has no direct route to the router's LAN and only a docker
# network does. See README "Если хост не видит роутер напрямую".
SMB_HOST=192.168.1.1
SMB_SHARE=downloads
SMB_USER=
SMB_PASSWORD=

# Host path bind-mounted into backend (read-only, at /mnt/downloads) and
# jellyfin (read-only, at /media). On the real deploy server this MUST be
# the SMB mount from the router (see README "Монтирование SMB-диска") —
# e.g. /mnt/downloads. Left unset, it defaults to ./data/downloads in this
# repo, which is fine for local testing on a Mac (Docker Desktop won't
# bind-mount arbitrary absolute paths like /mnt/downloads that don't exist
# on the host and aren't in its file-sharing allowlist).
HOST_DOWNLOADS_PATH=
